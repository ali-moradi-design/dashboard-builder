{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./src/*"],
      "@formweave/schema": ["./vendor/form-builder/packages/schema/src/index.ts"],
      "@formweave/schema/meta": ["./vendor/form-builder/packages/schema/src/meta.ts"],
      "@formweave/engine": ["./vendor/form-builder/packages/engine/src/index.ts"],
      "@formweave/engine/fields": ["./vendor/form-builder/packages/engine/src/fields/index.ts"],
      "@formweave/engine/fields/all": ["./vendor/form-builder/packages/engine/src/fields/all.ts"],
      "@formweave/engine/*": ["./vendor/form-builder/packages/engine/src/*.ts"],
      "@formweave/react": ["./vendor/form-builder/packages/react/src/index.ts"],
      "@formweave/react/fields": ["./vendor/form-builder/packages/react/src/fields/index.ts"]
    }
  },
  "include": [
    "src",
    "e2e",
    "scripts",
    "vite.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ]
}
